# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# A Neon API key, from https://console.neon.tech/app/settings/api-keys
# Branching needs a Neon account: the app creates one Neon project per agent and one
# branch per attempt.
NEON_API_KEY=

# Needed with a personal API key: the organization to create projects in (Organization
# settings > General). An organization API key implies it, so leave this empty.
NEON_ORG_ID=

# Optional overrides
# NEON_REGION=aws-us-east-2
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_APP_DOMAIN=agent37.app
# PORT=3000
# HOST=127.0.0.1   the server listens on loopback only; set 0.0.0.0 only behind your own auth
