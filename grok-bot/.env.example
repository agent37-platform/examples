# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Signs the visitor cookie that maps each browser to its own computer. Any long random
# string: openssl rand -hex 32
SESSION_SECRET=

# The https URL your Bots use to reach this server (notifications, the app sign-in return page).
# Agents run in the cloud, so localhost won't work: deploy this app, or for local dev run
#   cloudflared tunnel --url http://localhost:3000
# in another terminal and paste the https URL it prints.
PUBLIC_URL=

# Optional: the live screen. Build the desktop image once (see "Watch and take over its
# computer" in the README) and name its template here; new computers are created from it and
# the app shows their screen. Leave it unset to run on agent37-hermes with no screen.
# DESKTOP_TEMPLATE=hermes-vnc-desktop

# Optional overrides, the defaults are right for production
# INSTANCE_SHAPE=2/4   # vCPU/GB RAM per user's computer; 4/8 suits several Bots working at once
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_APP_DOMAIN=agent37.app
# PORT=3000
