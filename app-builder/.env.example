# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# The URL agents use to reach this server when they publish an app. Agents run in the
# cloud, so localhost won't work: deploy this app somewhere public, or for local dev run
#   cloudflared tunnel --url http://localhost:3000
# (add --protocol http2 if your network blocks QUIC and the tunnel never connects)
# in another terminal and paste the https URL it prints.
# It must be a plain https URL. When it changes, restart the server: every chat, old or
# new, then publishes to the new address.
PUBLIC_APP_URL=

# No Neon key: each app's agent creates its own database with Claimable Neon.

# Optional overrides, the defaults are right for production
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_SANDBOX_BASE=https://sandbox.agent37.app
# AGENT37_APP_DOMAIN=agent37.app
# PORT=3000
# HOST=127.0.0.1   the server listens on loopback only; set 0.0.0.0 only behind your own auth
