# Your Agent37 API key (server-side secret): https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_...

# Your OpenRouter API key: https://openrouter.ai/settings/keys
# Model usage bills to this key, not to your Agent37 wallet.
OPENROUTER_API_KEY=sk-or-...

# Optional: pin OpenRouter model slugs per Claude Code role. Unset = Claude Code's own
# defaults, which OpenRouter maps to the matching Anthropic models.
# Claude Code is built for Anthropic models; others can mishandle its tool calls.
# SONNET_MODEL=anthropic/claude-sonnet-5
# OPUS_MODEL=anthropic/claude-opus-5
# HAIKU_MODEL=anthropic/claude-haiku-4.5
# FABLE_MODEL=anthropic/claude-fable-5
