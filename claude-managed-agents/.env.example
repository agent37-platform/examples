# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Your Claude API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# A self-hosted environment and its environment key, from
# https://platform.claude.com/workspaces/default/environments
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_ENVIRONMENT_KEY=

# Printed by `node create-agent.mjs`
AGENT_ID=
