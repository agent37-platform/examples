# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Signs the cookie that ties each visitor to their own agent. Any long random string:
#   openssl rand -hex 32
SESSION_SECRET=

# The URL your agent uses to message you first (POST {PUBLIC_URL}/api/notify). Agents run in
# the cloud, so localhost won't work: deploy this app somewhere public, or for local dev run
#   cloudflared tunnel --url http://localhost:3101
# in another terminal and paste the https URL it prints.
PUBLIC_URL=

# Optional: show each agent's computer live beside the chat, with Take over. Build the desktop
# image once from custom-images/hermes-vnc-desktop in this repo:
#   npx agent37 templates build . --name hermes-vnc-desktop --default-port 3737
# then put the template name here. New agents are created from it; without it they run
# on agent37-hermes and the app shows no computer.
# DESKTOP_TEMPLATE=hermes-vnc-desktop

# Optional overrides, the defaults are right for production
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_APP_DOMAIN=agent37.app
# PORT=3101
