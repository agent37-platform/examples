# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# An admin-scoped Inkbox API key. Admin keys are minted only in the Inkbox Console:
# https://inkbox.ai/console. It stays on this server; each agent gets a key scoped to its
# own identity.
INKBOX_ADMIN_KEY=

# Signs the session cookie that maps a visitor to their assistant. Any long random string:
#   openssl rand -hex 32
SESSION_SECRET=

# The https URL agents (and Composio's OAuth redirect) use to reach this server. Agents run
# in the cloud, so localhost won't work: deploy this app, or for local dev run
#   cloudflared tunnel --url http://localhost:3102
# in another terminal and paste the https URL it prints.
PUBLIC_URL=

# Optional overrides, the defaults are right for production
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_APP_DOMAIN=agent37.app
# INKBOX_API_BASE=https://inkbox.ai/api/v1
# PORT=3102
