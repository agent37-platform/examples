# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Your Browser Use API key, from https://cloud.browser-use.com. It stays on this server.
BROWSER_USE_API_KEY=

# Signs the per-user tokens handed to agents. Any long random string: openssl rand -hex 32
BROKER_SECRET=

# The https URL agents use to reach this server. Agents run in the cloud, so localhost won't
# work: deploy it, or for local dev run
#   cloudflared tunnel --url http://localhost:3000
# in another terminal and paste the https URL it prints.
PUBLIC_URL=

# Optional
# BROWSER_TIMEOUT_MINUTES=15   # how long a user's browser lives, 1 to 240
# PORT=3000
